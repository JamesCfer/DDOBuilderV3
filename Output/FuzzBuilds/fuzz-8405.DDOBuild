        <ActiveGear>Standard</ActiveGear>
        <EquippedGear>
          <Name>Standard</Name>
          <Helmet>
            <Name>Darkstorm Helm</Name>
            <NoAutoUpdate/>
            <Icon>Helmet_11</Icon>
            <Description>Helms such as this, forged from some dark and glittering metal, are worn by
drow spellcasters both arcane and divine to heighten the power of their spells.
This helm can channel enough energy to start a brief thunderstorm.</Description>
            <DropLocation>Servants of the Overlord, locked chest, end chest</DropLocation>
            <MinLevel>16</MinLevel>
            <EquipmentSlot>
              <Helmet/>
            </EquipmentSlot>
            <Material>Gold</Material>
