          <Helmet>
            <Name>Helm of the White Dragon (Level 14)</Name>
            <Icon>Helmet_45a</Icon>
            <Description>This helm is crafted in the likeness of a ferocious white dragon.</Description>
            <DropLocation>Gianthold Tor, White Dragon 's chest (Heroic Elite)</DropLocation>
            <MinLevel>14</MinLevel>
            <EquipmentSlot>
              <Helmet/>
