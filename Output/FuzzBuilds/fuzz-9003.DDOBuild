          <Name>Standard</Name>
          <Helmet>
            <Name>Unbreakable Stormreach Guardian's Helm</Name>
            <Icon>Helmet_12</Icon>
            <Description>The Guards of Stormreach Harbor are known to wear these helmets at times. Putting
one's safety on the line day after day could drive the weaker-willed to madness.</Description>
            <DropLocation>Quarantine, End Chest</DropLocation>
            <MinLevel>14</MinLevel>
            <EquipmentSlot>
              <Helmet/>
            </EquipmentSlot>
            <Material>Steel</Material>
            <Buff>
