        <EquippedGear>
          <Name>Standard</Name>
          <Helmet>
            <Name>Scoundrel's Feathered Hat</Name>
            <Icon>Helmet_54</Icon>
            <Description>This fanciful hat sits delicately atop your horns. Somehow, the feather wasn't
damaged in the brawl.</Description>
            <DropLocation>Advance to level 15, End reward</DropLocation>
            <MinLevel>15</MinLevel>
            <EquipmentSlot>
              <Helmet/>
            </EquipmentSlot>
            <Material>Steel</Material>
            <Buff>
              <Type>MagicalSheltering</Type>
