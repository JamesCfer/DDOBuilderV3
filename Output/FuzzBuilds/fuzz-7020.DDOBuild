            </Buff>
            <Buff>
              <Type>HealingAmplification</Type>
              <Value1>20</Value1>
              <BonusType>Exceptional</BonusType>
            </Buff>
          </Helmet>
          <Necklace>
            <Name>Necklace of Venom</Name>
            <Icon>Necklace_4</Icon>
            <Description>Drow assassins say this necklace is infused with Vulkoor's subtle poisons. Wearing
it will make one's attacks deft and lethal.</Description>
            <DropLocation>The Claw of Vulkoor, End reward</DropLocation>
            <MinLevel>7</MinLevel>
            <EquipmentSlot>
              <Necklace/>
            </EquipmentSlot>
            <Material>Steel</Material>
            <SetBonus>Vulkoor's Cunning</SetBonus>
          </Necklace>
          <Trinket>
            <Name>Five Rings</Name>
            <Icon>Ring_30</Icon>
            <Description>A set of rings which adorn each finger, torn from the dead hands of the Slave
Masters.</Description>
            <DropLocation>Secret of the Slavers' Stockade, Small chest</DropLocation>
            <MinLevel>8</MinLevel>
            <EquipmentSlot>
              <Trinket/>
            </EquipmentSlot>
            <Material>Silver</Material>
          </Trinket>
          <Cloak>
            <Name>Quilted Cape</Name>
            <Icon>Cloak_5</Icon>
            <Description>A mother-of-pearl clasps fastens this patchwork garment across its wearer's
