          <Name>Standard</Name>
          <Helmet>
            <Name>University Investigator's Hat</Name>
            <Icon>Helmet_2</Icon>
            <Description>The markings on this hat make it seem as if it were once used by an Inquisitive,
but its destiny remains a mystery.</Description>
            <DropLocation>What Dreams May Come, End chest</DropLocation>
            <MinLevel>18</MinLevel>
            <EquipmentSlot>
              <Helmet/>
            </EquipmentSlot>
            <Material>Gem (material)</Material>
            <Buff>
