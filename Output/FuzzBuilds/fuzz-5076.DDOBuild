          <Necklace>
            <Name>Melri's Breath</Name>
            <Icon>Necklace_3d</Icon>
            <Description>This slender necklace is cold to the touch and is said to have protected its
previous wielder by shielding them with ice.</Description>
            <DropLocation>The Gate Chamber, End Chest</DropLocation>
            <MinLevel>7</MinLevel>
            <EquipmentSlot>
              <Necklace/>
            </EquipmentSlot>
            <Material>Steel</Material>
            <Buff>
              <Type>EnergyResistance</Type>
              <Value1>10</Value1>
              <BonusType>Enhancement</BonusType>
              <Description1>Cold</Description1>
              <Item>Cold</Item>
            </Buff>
