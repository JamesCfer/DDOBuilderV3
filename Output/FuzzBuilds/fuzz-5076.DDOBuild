              <Type>AbilityBonus</Type>
              <Value1>4</Value1>
              <BonusType>Enhancement</BonusType>
              <Description1>Constitution</Description1>
              <Item>Constitution</Item>
            </Buff>
          </Necklace>
          <Trinket>
            <Name>Mindfury Symbiont</Name>
            <Icon>Trinket_61</Icon>
            <Description>Allow this leech-like creature to latch onto you and it will boost the power
of your spells, as well as protecting your mind against incoming magic. However,
it will also feed off of and weaken your body in exchange.</Description>
            <DropLocation>In The Flesh, end chest (Heroic Hard or Elite)</DropLocation>
            <MinLevel>15</MinLevel>
            <EquipmentSlot>
              <Trinket/>
            </EquipmentSlot>
            <Material>Flesh</Material>
            <Buff>
              <Type>SpellFocus</Type>
              <Value1>25</Value1>
              <BonusType>Equipment</BonusType>
              <Description1>I</Description1>
            </Buff>
            <Buff>
              <Type>SpellLoreNumeral</Type>
              <Value1>6</Value1>
              <BonusType>Equipment</BonusType>
              <Description1>VI</Description1>
            </Buff>
            <Buff>
              <Type>AbilityBonus</Type>
              <Value1>-2</Value1>
              <BonusType>Penalty</BonusType>
              <Description1>Constitution</Description1>
              <Item>Constitution</Item>
            </Buff>
            <Buff>
              <Type>FortitudeSave</Type>
              <Value1>-2</Value1>
              <BonusType>Penalty</BonusType>
            </Buff>
          </Trinket>
          <Cloak>
            <Name>Cloak of Night (level 20)</Name>
            <Icon>Cloak_14</Icon>
            <Description>This Cloak is as smooth and dark as the most pitch-black of nights. Wearing
it makes you difficult to spot and attack, and by awakening its powers you
will enable it to aid you against creatures native to the darkness.</Description>
            <DropLocation>The Night Revels, Turn in and Cloak of Night (level 16) 
 and 250 Piece of Darkest Chocolate; obtained in the Graveyard mob slayer, Hayweird Foundry, or Getting Ahead in Lordsmarch Palace 120 Spooky Almond, obtained in Under New Ravagement, Hayweird Foundry, or Getting Ahead in Lordsmarch Palace 100 Black Apple; obtained in Haverdashed, Hayweird Foundry, or Getting Ahead in Lordsmarch Palace</DropLocation>
            <MinLevel>20</MinLevel>
            <EquipmentSlot>
              <Cloak/>
            </EquipmentSlot>
            <Material>Leather</Material>
            <Buff>
              <Type>Invisibility Guard</Type>
            </Buff>
            <Buff>
              <Type>Ghostly</Type>
              <BonusType>Enhancement</BonusType>
            </Buff>
            <Buff>
