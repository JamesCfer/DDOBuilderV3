          </Necklace>
          <Trinket>
            <Name>Epic Gem of Many Facets</Name>
            <Icon>Trinket_29a</Icon>
            <Description>From this chain hangs a gem that is very finely cut, giving it countless glittering
faces. It can take the place of various other items for the purpose of activating
certain set bonuses.</Description>
            <DropLocation>Epic version of Gem of Many Facets</DropLocation>
            <MinLevel>20</MinLevel>
            <EquipmentSlot>
              <Trinket/>
            </EquipmentSlot>
            <Material>Gem (material)</Material>
          </Trinket>
