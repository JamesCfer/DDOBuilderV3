          <Necklace>
            <Name>Climber's Remembrance</Name>
            <Icon>Necklace_14</Icon>
            <Description>On donning this necklace, you remember a murder most foul, the determination
of vengeance, the gleam of armor, and a fatal uphill climb.</Description>
            <DropLocation>The Wish, end chest (rare)</DropLocation>
            <MinLevel>8</MinLevel>
            <EquipmentSlot>
              <Necklace/>
            </EquipmentSlot>
            <Material>Gem (material)</Material>
