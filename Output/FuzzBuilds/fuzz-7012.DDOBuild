          </Helmet>
          <Necklace>
            <Name>Necklace of Glib Tongue (Level 4)</Name>
            <Icon>Necklace_2</Icon>
            <Description>An ancient Wizard constructed a series of these necklaces in an attempt to make
it easier to listen to the populace surrounding his tower.</Description>
            <DropLocation>Mimic Hunt, Turn in 80 Mimic Tokens</DropLocation>
            <MinLevel>4</MinLevel>
            <EquipmentSlot>
              <Necklace/>
            </EquipmentSlot>
            <Material>Leather</Material>
