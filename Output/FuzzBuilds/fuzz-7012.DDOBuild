        <EquippedGear>
          <Name>Standard</Name>
          <Helmet>
            <Name>Memories of the Mighty</Name>
            <Icon>Helmet_2</Icon>
            <Description>A fragment of a misplaced thought, a brilliant light you once remembered. This
tattered memory was once the face of someone mighty.</Description>
            <DropLocation>Memory Lapse, End chest</DropLocation>
            <MinLevel>6</MinLevel>
            <EquipmentSlot>
              <Helmet/>
