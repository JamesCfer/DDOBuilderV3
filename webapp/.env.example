PORT=3001
# Path to the DDO data files directory (with or without trailing slash)
DATA_FILES_PATH=../Output/DataFiles
# Where the community accounts/builds database is stored
#COMMUNITY_DB_PATH=./data/community.json
# Enable "Sign in with Google" on the Account page: create an OAuth 2.0
# Web application client at https://console.cloud.google.com/apis/credentials
# (authorized JavaScript origin = the URL the app is served from) and paste
# its client id here. Leave unset to hide the Google button entirely.
#GOOGLE_CLIENT_ID=1234567890-example.apps.googleusercontent.com
